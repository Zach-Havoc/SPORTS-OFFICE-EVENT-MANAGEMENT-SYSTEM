# Backend API base URL (must include the /api suffix, no trailing slash).
# Copy this file to `.env` and set the value for how you run the app.
#
#   iOS simulator / web ....... http://localhost:8000/api
#   Android emulator .......... http://10.0.2.2:8000/api
#   Physical device .......... http://192.168.x.x:8000/api   (your computer's LAN IP)
#   Production ............... https://your-domain.example/api

EXPO_PUBLIC_API_URL=http://localhost:8000/api

# --- EAS cloud builds (eas build) ---
# This .env file only affects `expo start`/local dev — it never reaches
# Expo's build servers. eas.json's "development"/"preview"/"production"
# profiles each reference a same-named EAS "environment" instead; set each
# one's EXPO_PUBLIC_API_URL once via:
#
#   eas env:create --name EXPO_PUBLIC_API_URL --environment preview \
#     --value http://<your-LAN-IP>:8000/api --visibility plaintext
#   eas env:create --name EXPO_PUBLIC_API_URL --environment production \
#     --value https://<your-deployed-backend-domain>/api --visibility plaintext
#
# (see `eas env:list` / `eas env:list --environment production` to confirm,
# and https://docs.expo.dev/eas/environment-variables/ for the full picture)
