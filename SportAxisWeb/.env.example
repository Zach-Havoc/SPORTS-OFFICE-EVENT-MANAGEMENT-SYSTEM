# Vite loads env files by mode: `npm run dev` (mode "development") reads
# .env + .env.development(.local); `npm run build` / `npm run preview`
# (mode "production") reads .env + .env.production(.local). Values in the
# mode-specific file win over plain .env. So: put your local dev values in
# .env (as below), and put the real deployed values in .env.production —
# then `npm run build` picks up production automatically, no manual editing
# or env-var juggling needed. All of these are gitignored except this file;
# copy this to .env for local dev and to .env.production before deploying.

# Laravel API base URL
VITE_API_URL=http://localhost:8000/api

# Real-time live scores (Laravel Reverb). Leave VITE_REVERB_APP_KEY unset to
# keep the board on its 60s polling fallback. When set, it must match the
# backend's REVERB_APP_KEY, and `php artisan reverb:start` must be running.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
