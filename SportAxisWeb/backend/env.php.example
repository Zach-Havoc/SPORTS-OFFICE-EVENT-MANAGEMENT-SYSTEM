<?php

/**
 * Production env for the InfinityFree split deploy — copy this to
 * `core/env.php` on the server (NOT into the repo, NOT as `.env`) and fill
 * in the real values. See INFINITYFREE_DEPLOYMENT.md for the full walkthrough.
 *
 * Why a plain PHP array instead of a real `.env` file: this is read and fed
 * into putenv()/$_ENV by the root index.php BEFORE Laravel boots (see that
 * file), which sidesteps ever needing phpdotenv to successfully parse a
 * `.env` file off disk on a host we don't control. Everything else about
 * Laravel — every config/*.php file, every env() call — works completely
 * unchanged; this only changes *how* those values get into the environment.
 *
 * Local dev is NOT affected by this file at all — it keeps using the normal
 * `.env` exactly as before. This file only exists for the InfinityFree copy
 * of the app, inside core/.
 */

return [
    'APP_NAME' => 'SportsAxis',
    'APP_ENV' => 'production',
    // Generate locally with: php artisan key:generate --show
    'APP_KEY' => 'base64:REPLACE_WITH_YOUR_REAL_APP_KEY',
    'APP_DEBUG' => 'false',
    // This backend's own InfinityFree domain (the second hosting slot —
    // NOT the web app's domain).
    'APP_URL' => 'https://REPLACE-WITH-YOUR-BACKEND-DOMAIN.infinityfreeapp.com',

    // Protects /artisan-migrate — generate with: openssl rand -hex 32
    'MIGRATION_TOKEN' => 'REPLACE_WITH_A_LONG_RANDOM_SECRET',

    // The web app's domain(s) — must match exactly (scheme + host, no
    // trailing slash) or the browser will block every API call as CORS.
    'CORS_ALLOWED_ORIGINS' => 'https://sportsaxis-arasofbsu.page.gd',

    'SANCTUM_TOKEN_EXPIRATION' => '10080',

    // From InfinityFree's MySQL Databases panel.
    'DB_CONNECTION' => 'mysql',
    'DB_HOST' => 'sqlXXX.infinityfree.com',
    'DB_PORT' => '3306',
    'DB_DATABASE' => 'if0_XXXXXXX_sportsaxis',
    'DB_USERNAME' => 'if0_XXXXXXX',
    'DB_PASSWORD' => 'REPLACE_WITH_YOUR_INFINITYFREE_MYSQL_PASSWORD',

    // database-backed, not file-based — avoids relying on storage/
    // write-permission quirks on shared hosting for session state.
    'SESSION_DRIVER' => 'database',
    'CACHE_STORE' => 'database',

    // Forced overrides — InfinityFree can't run a persistent process, so
    // neither Reverb nor a real queue worker can run here:
    //   - BROADCAST_CONNECTION=log: live scores silently fall back to the
    //     client's 60s polling instead of true push — degraded, not broken.
    //   - QUEUE_CONNECTION=sync: queued jobs run inline on the triggering
    //     request instead of async — slower per-request, but nothing gets
    //     silently stuck unprocessed in a queue no worker is draining.
    'BROADCAST_CONNECTION' => 'log',
    'QUEUE_CONNECTION' => 'sync',

    'FILESYSTEM_DISK' => 'local',

    // Gmail SMTP — leave blank to disable email (signup/reset emails just
    // won't send; nothing crashes).
    'MAIL_MAILER' => 'smtp',
    'MAIL_SCHEME' => 'smtp',
    'MAIL_HOST' => 'smtp.gmail.com',
    'MAIL_PORT' => '587',
    'MAIL_USERNAME' => '',
    'MAIL_PASSWORD' => '',
    'MAIL_FROM_ADDRESS' => '',
    'MAIL_FROM_NAME' => 'SportsAxis',

    // Wherever the OCR service actually ended up hosted (Oracle/Cloud
    // Run/Render) — see OCR/README.md. Leave OCR_SERVICE_URL at localhost
    // and OCR scanning simply won't work (fails per-request, nothing else
    // breaks) until this is filled in.
    'OCR_SERVICE_URL' => 'http://127.0.0.1:5001',
    'OCR_API_KEY' => '',
];
