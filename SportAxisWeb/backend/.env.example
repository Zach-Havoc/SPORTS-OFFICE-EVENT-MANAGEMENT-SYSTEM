APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SECURITY: APP_DEBUG must be false in any deployed / internet-facing
# environment. Debug mode leaks stack traces, env vars and DB credentials.
APP_DEBUG=true
APP_URL=http://localhost

# `php artisan serve` listens on the network, not just this computer, so the
# mobile app on a phone can reach it at http://<this machine's LAN IP>:8000.
SERVER_HOST=0.0.0.0

# Comma-separated list of browser origins allowed to call the API (CORS).
# Lock this to your real frontend origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# Sanctum bearer-token lifetime in minutes (default 7 days). Tokens issued
# by /login and /signup expire after this window.
SANCTUM_TOKEN_EXPIRATION=10080

# Protects GET /artisan-migrate (see app/Http/Controllers/MaintenanceController.php)
# — the only way to run migrations/seeders on a host with no CLI access
# (InfinityFree). Leave empty for local dev (the endpoint 403s when empty).
# Generate a real one for production with: openssl rand -hex 32
MIGRATION_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION: this MUST be `reverb`, not `log`.
# Real-time live scores/leaderboards are pushed over this connection. Set to
# `reverb` AND keep a `php artisan reverb:start` process running under a
# supervisor (systemd/supervisor) at all times in production.
# Leaving this as `log` does NOT crash anything — it silently degrades to the
# client's ~30s polling fallback instead of true real-time updates. That
# "works but degraded" behavior is exactly why it's easy to ship by accident;
# the app logs a Log::warning on boot if it detects this combination
# (APP_ENV=production + BROADCAST_CONNECTION=log), but don't rely on
# noticing that — set this correctly before deploying.
# The default below (`log`) is intentional for local/dev: a fresh clone with
# reverb:start NOT running should degrade to polling, not break outright.
# ─────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
REVERB_APP_ID=sportaxis
REVERB_APP_KEY=sportaxis-local-key
REVERB_APP_SECRET=sportaxis-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP. Use a Google "App Password" (Account > Security > 2-Step
# Verification > App passwords), entered WITHOUT spaces, as MAIL_PASSWORD.
# MAIL_FROM_ADDRESS must equal MAIL_USERNAME or Gmail will rewrite/reject it.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD="your16charapppassword"
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="SportsAxis"

# Dual-purpose: (a) general app file storage on the `s3` disk
# (config/filesystems.php), and (b) automatic offsite copies of
# `php artisan backup:database` dumps (uploaded to `backups/` on this bucket)
# once AWS_BUCKET is filled in — see docs/BACKUP.md. Leave blank in local/dev;
# the app and the backup command both degrade gracefully (local disk only,
# no error) when unconfigured. Works with any S3-compatible endpoint, not
# just AWS — set AWS_ENDPOINT and AWS_USE_PATH_STYLE_ENDPOINT=true for those.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The /api/ocr/extract scoresheet-reading endpoint calls a local, free,
# self-hosted PaddleOCR service (OCR/service.py in the repo root — start it
# with OCR/start.sh, see OCR/README.md) instead of a paid cloud/AI vision API.
# Only change this if that service runs somewhere other than its default
# localhost port — e.g. a separately-hosted VM's public IP, once this
# backend itself is deployed somewhere that can't run Python (InfinityFree).
OCR_SERVICE_URL=http://127.0.0.1:5001

# Only needed when OCR_SERVICE_URL points somewhere internet-reachable
# (not localhost) — must match OCR_API_KEY in that service's own
# environment (its systemd unit), or every request gets rejected with 401.
# Leave empty for local dev.
OCR_API_KEY=

# No longer used (OCR now runs on the free local PaddleOCR service above) —
# kept only in case a paid vision-AI model is reintroduced later.
ANTHROPIC_API_KEY=
