# SportsAxis — one InfinityFree domain serves both this SPA and the Laravel
# API (see INFINITYFREE_DEPLOYMENT.md). Real files/assets are served
# directly; everything else — SPA client-side routes AND /api|/sanctum
# calls — goes through index.php, which decides which of those two it is
# (see that file). This is deliberately NOT a plain "fall back to
# index.html" rule: an index.php sitting alongside index.html at the same
# path means Apache's normal DirectoryIndex would try index.php first for
# "/" anyway, so index.php has to be the one universal front door, not a
# second thing competing with it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laravel's stock .htaccess (backend/public/.htaccess, which never actually
  # serves production traffic in this split-layout deploy — see index.php)
  # carries this rule by default, but this custom front-door file was written
  # from scratch and never got it: on Apache+PHP setups here, the
  # Authorization header otherwise never reaches PHP at all, so every Sanctum
  # Bearer-token request looks like an anonymous guest request and gets a
  # blanket 401 — login (public, no token needed) works, everything
  # authenticated after it doesn't. This must come before the catch-all
  # rewrite below and apply unconditionally to every request.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Laravel's storage disk (department logos, site carousel slides,
  # coach-uploaded requirement PDFs, OCR-captured score-sheet photos — every
  # asset(), 'storage/'.$filename) URL the backend generates) normally
  # reaches disk via the standard `public/storage` symlink. There's no
  # core/public/ in this split layout, and PHP's symlink() is disabled on
  # many shared hosts anyway — so map the URL straight to the real path
  # instead of depending on a symlink existing at all. This directory's own
  # access rule (see core/storage/app/public/.htaccess) has to explicitly
  # allow this, since core/.htaccess denies everything else in core/ by
  # default.
  RewriteRule ^storage/(.*)$ core/storage/app/public/$1 [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Compress API/SPA responses — this is the actual front door for /api/* on the
# split-layout InfinityFree deploy (see index.php), so backend/public/.htaccess's
# own copy of this block never applies in production; this is the one that counts.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript
</IfModule>
